# Copy to .env for `netlify dev`. Never commit .env — it is gitignored.
# In the deployed site these are set as Netlify environment variables.

# API key for the UKY retrieve-docs endpoint. Server-side only: the Netlify
# function holds it and it must never reach the browser.
UKY_API_KEY=

# Full URL of the UKY retrieve-docs endpoint.
UKY_RETRIEVE_URL=

# Comma-separated origins allowed to call /api/search from a browser.
# Production embeds the widget on the support site; wildcards cover multidevs.
ALLOWED_ORIGINS=https://support.access-ci.org
